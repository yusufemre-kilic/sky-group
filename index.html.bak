t e=document.createElement("img");return e.alt="",e.className="bcc-core-rain-drop bcc-core-rain-drop-static",e.dataset.bccCoreRainDrop="static",e.decoding="async",e.draggable=!1,e.height=512,e.loading="eager",e.src=n.asset,e.width=512,i(e,"--core-rotation-static",`${n.rotation}deg`),i(e,"--core-size",`${n.size}px`),i(e,"--core-x",`${n.x}vw`),i(e,"--core-y",`${n.y}vh`),e},y=()=>{if(t.dataset.bccCoreRainActive){const C=t.dataset.bccCoreRainMode==="falling";s(),C&&t.offsetWidth}b(),t.dataset.bccCoreRainActive="true";const n=m.matches;if(t.dataset.bccCoreRainMode=n?"static":"falling",g.textContent=n?"Base Core constellation.":"Base Core shower.",n){c.replaceChildren(...M(window.innerWidth).map(p)),u=window.setTimeout(s,1200);return}const e=x(window.innerWidth);c.replaceChildren(...e.map(w));const R=Math.max(...e.map(C=>C.delay+C.duration));u=window.setTimeout(s,R+300)};return c.addEventListener("animationend",n=>{const e=n.target;!(e instanceof HTMLElement)||e.dataset.bccCoreRainDrop!=="falling"||(e.remove(),c.children.length||s())},{signal:o.signal}),a.addEventListener("click",y,{signal:o.signal}),m.addEventListener("change",()=>{t.dataset.bccCoreRainActive&&s()},{signal:o.signal}),window.addEventListener("pagehide",s,{signal:o.signal}),()=>{o.abort(),v?.disconnect(),f=[],s(),delete t.dataset.bccCoreRainReady}}S();</script> <section class="bcc-faq" aria-labelledby="bcc-faq-head"> <div class="bcc-faq-inner">  <div class="bcc-faq-title">  <span class="bcc-faq-tape" data-bcc-reveal><span class="bpc-tape-eyebrow">Got questions?</span></span> <h2 class="bcc-faq-head" id="bcc-faq-head" data-bcc-reveal style="--rd:0.08s">
We’ve got answers<svg width="100%" height="10" viewBox="44 149 212 19" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none" class="block bcc-faq-stroke"><path d="M46.189 161.553C58.3867 161.345 70.6266 161.191 82.6133 158.867C120.776 155.148 158.334 150.869 196.547 150.155C215.572 149.797 234.873 150.048 253.67 151.024C257.336 154.132 250.725 155.061 248.351 155.261C228.982 156.892 206.756 155.168 186.983 155.781C141.587 157.188 96.8898 165.033 52.0009 166.516C49.9952 166.583 47.905 166.597 46.0849 165.638C44.7768 164.175 45.1425 162.963 46.1918 161.553L46.189 161.553Z" fill="#ed6c30"></path></svg> </h2> </div> <div class="bcc-faq-list"> <details class="bcc-faq-row" name="bcc-faq" open data-bcc-reveal style="--rd:0.16s"> <summary class="bcc-faq-q"> <span>What is Base? What is Base Core?</span> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down shrink-0 bcc-faq-chev" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg> </summary> <div class="bcc-faq-a"> <p class="text-body-lg">Base is an energy company building a grid for the future so Americans can enjoy affordable, reliable power. We design, build, install, and operate home batteries that back up your home, save your money, and support the grid.</p><p class="text-body-lg">Base Core is our next generation home battery, designed from the ground up to support the grid and now in production at Base Factory 1 in Austin. It backs up your whole home, switches over seamlessly when the grid drops, and can withstand conditions from Texas summers and Chicago winters.</p> </div> </details><details class="bcc-faq-row" name="bcc-faq" data-bcc-reveal style="--rd:0.22s"> <summary class="bcc-faq-q"> <span>How long will it back me up?</span> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down shrink-0 bcc-faq-chev" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg> </summary> <div class="bcc-faq-a"> <p class="text-body-lg">Base Core holds 39.2 kWh of energy, which is ~3x the size of typical batteries. How long it lasts depends on how much power you use. A battery stores a fixed amount of energy, so running high-usage devices like A/C drains it faster, just like a bigger hose empties a bucket more quickly.</p><p class="text-body-lg">At reduced usage, a Base Core can back you up for up to 36 hours. For context, 97% of outages in Texas are less than 2.5 hours long.</p><p class="text-body-lg">In the case of an extended outage, Core has a built-in generator port that lets you recharge it from a standard portable generator, so you stay powered as long as you have fuel. The Base app shows a real-time estimate of your remaining backup time, at both your current usage and reduced usage.</p> </div> </details><details class="bcc-faq-row" name="bcc-faq" data-bcc-reveal style="--rd:0.28s"> <summary class="bcc-faq-q"> <span>What is the warranty?</span> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down shrink-0 bcc-faq-chev" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg> </summary> <div class="bcc-faq-a"> <p class="text-body-lg">You don’t take on the risk of owning or maintaining the hardware. Base retains ownership of the battery for the full term of your agreement, which means we warranty it and handle all service and maintenance, typically within days and at no cost to you. Base covers 100% of maintenance for manufacturing defects, installation defects, and other damage outside your control.</p> </div> </details><details class="bcc-faq-row" name="bcc-faq" data-bcc-reveal style="--rd:0.34s"> <summary class="bcc-faq-q"> <span>Why is Base significantly less expensive than alternatives?</span> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down shrink-0 bcc-faq-chev" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg> </summary> <div class="bcc-faq-a"> <p class="text-body-lg">Base’s shared business model is what sets us apart. Instead of charging a high margin, Base earns most of its income from grid support — helping the power grid when it’s under strain.</p><p class="text-body-lg">That’s why whole-home backup costs a few hundred dollars upfront instead of tens of thousands for a generator, or the years-long payback of a solar-and-battery system.</p><p class="text-body-lg">We also build everything ourselves and pass those savings to you. We design the battery, build it at our factory in Austin, install it with our own electricians, and keep watching over it after that.</p> </div> </details><details class="bcc-faq-row" name="bcc-faq" data-bcc-reveal style="--rd:0.40s"> <summary class="bcc-faq-q"> <span>What testing certifications does it have?</span> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down shrink-0 bcc-faq-chev" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg> </summary> <div class="bcc-faq-a"> <p class="text-body-lg">Core is certified under UL 1973, UL 9540, UL 991, UL 1998, UL 1741, IEEE 1547-2003. UL certification is the gold standard for electrical system safety in home appliances, including rigorous fire safety standards.</p><p class="text-body-lg">Core uses lithium iron phosphate (LFP) chemistry, one of the safest battery types available. It’s more stable under high temperatures and far less likely to overheat than standard EV battery chemistries.</p><p class="text-body-lg">Beyond certifications, Core went through extensive test programs: IP67 submersion testing (rated to 3 feet), IPX9K high-pressure water testing, and internal flash-flood testing. It operates from -22 to 122 °F, built for the hottest Texas summers and the coldest Chicago winters. Every installation is performed by certified, bonded, insured, and licensed electricians under Base’s Texas master electrician (license #476697), or licensed by local regulatory agencies.</p> </div> </details> </div> </div> </section> <section class="bcc-nf" data-bcc-scrub="runway" data-bcc-cue="0.78" aria-labelledby="bcc-nf-title"> <div class="bcc-nf-screen" data-bcc-screen> <div class="bcc-nf-stage"> <div class="bcc-nf-layer" style="--sky:#338da2">  <img class="bcc-nf-fit" src="/_bpc/assets/base-core-concept/nightfall-01.avif" alt aria-hidden="true" width="1280" height="720" loading="eager" fetchpriority="high" decoding="async"> </div><div class="bcc-nf-layer" data-nf-fade style="--sky:#286b80; --ws:0.1600; --wd:0.0837">  <img class="bcc-nf-fit" src="/_bpc/assets/base-core-concept/nightfall-02.avif" alt aria-hidden="true" width="1280" height="720" loading="eager" decoding="async"> </div><div class="bcc-nf-layer" data-nf-fade style="--sky:#215368; --ws:0.2270; --wd:0.0871">  <img class="bcc-nf-fit" src="/_bpc/assets/base-core-concept/nightfall-03.avif" alt aria-hidden="true" width="1280" height="720" loading="eager" decoding="async"> </div><div class="bcc-nf-layer" data-nf-fade style="--sky:#1d4355; --ws:0.2966; --wd:0.0688">  <img class="bcc-nf-fit" src="/_bpc/assets/base-core-concept/nightfall-04.avif" alt aria-hidden="true" width="1280" height="720" loading="lazy" decoding="async"> </div><div class="bcc-nf-layer" data-nf-fade style="--sky:#152b41; --ws:0.3517; --wd:0.0989">  <img class="bcc-nf-fit" src="/_bpc/assets/base-core-concept/nightfall-05.avif" alt aria-hidden="true" width="1280" height="720" loading="lazy" decoding="async"> </div><div class="bcc-nf-layer" data-nf-fade style="--sky:#132438; --ws:0.4308; --wd:0.0556">  <img class="bcc-nf-fit" src="/_bpc/assets/base-core-concept/nightfall-06.avif" alt aria-hidden="true" width="1280" height="720" loading="lazy" decoding="async"> </div><div class="bcc-nf-layer" data-nf-fade style="--sky:#122136; --ws:0.4753; --wd:0.0509">  <img class="bcc-nf-fit" src="/_bpc/assets/base-core-concept/nightfall-07.avif" alt aria-hidden="true" width="1280" height="720" loading="lazy" decoding="async"> </div><div class="bcc-nf-layer" data-nf-fade style="--sky:#112034; --ws:0.5160; --wd:0.0408">  <img class="bcc-nf-fit" src="/_bpc/assets/base-core-concept/nightfall-08.avif" alt aria-hidden="true" width="1280" height="720" loading="lazy" decoding="async"> </div><div class="bcc-nf-layer" data-nf-fade style="--sky:#111e32; --ws:0.5486; --wd:0.0330">  <img class="bcc-nf-fit" src="/_bpc/assets/base-core-concept/nightfall-09.avif" alt aria-hidden="true" width="1280" height="720" loading="lazy" decoding="async"> </div><div class="bcc-nf-layer" data-nf-fade style="--sky:#101d31; --ws:0.5750; --wd:0.0438">  <img class="bcc-nf-fit" src="/_bpc/assets/base-core-concept/nightfall-10.avif" alt="A Texas suburb at night under a starry sky, every house dark except one with its windows lit" width="1280" height="720" loading="lazy" decoding="async"> </div>  <div class="bcc-nf-dim" aria-hidden="true"></div>  <div class="bcc-nf-scrim" aria-hidden="true"></div>  <div class="bcc-nf-glow bcc-nf-fit" aria-hidden="true"><span class="bcc-nf-glow-dot"></span></div> </div> <div class="bcc-nf-copy">   <h2 class="bcc-nf-head" id="bcc-nf-title"> <span class="bcc-nf-line"><span class="bcc-nf-word" style="--ws:0.0500; --wd:0.075">When</span> <span class="bcc-nf-word" style="--ws:0.0820; --wd:0.075">the</span> <span class="bcc-nf-word" style="--ws:0.1140; --wd:0.075">grid</span> <span class="bcc-nf-word" style="--ws:0.1460; --wd:0.075">goes</span> <span class="bcc-nf-word" style="--ws:0.1780; --wd:0.075">down,</span></span> <span class="bcc-nf-line"><span class="bcc-nf-word" style="--ws:0.3400; --wd:0.075">your</span> <span class="bcc-nf-word" style="--ws:0.3720; --wd:0.075">home</span> <span class="bcc-nf-word" style="--ws:0.4040; --wd:0.075">doesn’t.</span></span> </h2> <div class="bcc-nf-payoff"> <p class="bcc-nf-payoff-head">Say hello to affordable &amp; reliable power</p> <p class="bcc-nf-payoff-sub">
Base Core is currently available in Texas and Illinois. Find out if we’re in your
          neighborhood in less than 30 seconds.
</p> <a class="inline-flex touch-manipulation items-center justify-center gap-2 font-semibold transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-primary-foreground disabled:pointer-events-none select-none whitespace-nowrap bg-brand-primary text-text-brand hover:bg-brand-primary-subtle disabled:bg-surface-subtle disabled:text-text-muted py-3 px-4 rounded text-body-lg bcc-nf-btn" href="/get-started">Get started</a> </div> </div> </div> </section> </div>  <div class="bcc-rail" style="--rail-exit: 13.05" aria-hidden="true"> <span class="bcc-rail-slot" style="--i: 0"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 1"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 2"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 3"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 4"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 5"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 6"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 7"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 8"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 9"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 10"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 11"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 12"> <span class="bcc-rail-pill"></span> </span><span class="bcc-rail-slot" style="--i: 13"> <span class="bcc-rail-pill"></span> </span> </div>  <div class="bcc-modal-host"> <script>(()=>{var l=(n,t)=>{let i=async()=>{await(await n())()},e=typeof t.value=="object"?t.value:void 0,s={timeout:e==null?void 0:e.timeout};"request