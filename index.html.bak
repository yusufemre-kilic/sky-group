go next ›</a> </div> </div> </div> </section> <section class="bcc-bp" data-bcc-scrub="runway" data-bcc-steps="4" data-bcc-snap data-bcc-snap-off="(max-width: 767.9px), (max-height: 720px), (pointer: coarse)" style="--n:4">  <i class="bcc-bp-stop bcc-bp-stop-out bcc-bp-stop-back" aria-hidden="true"></i> <i class="bcc-bp-stop bcc-bp-stop-seam" aria-hidden="true"></i> <i class="bcc-bp-stop" style="--at:0.125" aria-hidden="true"></i><i class="bcc-bp-stop" style="--at:0.375" aria-hidden="true"></i><i class="bcc-bp-stop" style="--at:0.625" aria-hidden="true"></i><i class="bcc-bp-stop" style="--at:0.875" aria-hidden="true"></i> <i class="bcc-bp-stop" style="--at:1" aria-hidden="true"></i> <i class="bcc-bp-stop bcc-bp-stop-out bcc-bp-stop-on" aria-hidden="true"></i> <div class="bcc-bp-screen" data-bcc-screen data-bcc-clear> <div class="bcc-bp-grid"> <div class="bcc-bp-card" data-bcc-reveal style="--rd:0.06s"> <img class="bcc-bp-img" data-shot="battery" src="/_bpc/assets/base-core-concept/better-battery-960.avif" srcset="/_bpc/assets/base-core-concept/better-battery-480.avif 480w, /_bpc/assets/base-core-concept/better-battery-960.avif 960w, /_bpc/assets/base-core-concept/better-battery-1360.avif 1360w" sizes="(min-width: 768px) min(52vw, 676px), calc(100vw - 44px)" alt="A Base Core home battery installed against a garden wall" width="1360" height="1338" loading="lazy" decoding="async"><img class="bcc-bp-img" data-shot="install" style="--wb:0.2500" src="/_bpc/assets/base-core-concept/better-install-960.avif" srcset="/_bpc/assets/base-core-concept/better-install-480.avif 480w, /_bpc/assets/base-core-concept/better-install-960.avif 960w, /_bpc/assets/base-core-concept/better-install-1360.avif 1360w" sizes="(min-width: 768px) min(52vw, 676px), calc(100vw - 44px)" alt="A Base technician kneeling beside a Core battery at a brick wall, opening its top panel" width="1360" height="1338" loading="lazy" decoding="async"><img class="bcc-bp-img" data-shot="winter" style="--wb:0.5000" src