ne" width="100%" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="size-12 shrink-0" style="--ic-bg:var(--color-green-20);--ic-fg:var(--color-green-90)"><path d="M60.5 109.71C60.5 82.5321 82.5321 60.5 109.71 60.5H270.29C297.468 60.5 319.5 82.5321 319.5 109.71V270.29C319.5 297.468 297.468 319.5 270.29 319.5H109.71C82.5321 319.5 60.5 297.468 60.5 270.29V109.71Z" fill="var(--ic-bg)"></path><path d="M297 109.71C297 94.9584 285.042 83 270.29 83H109.71C94.9585 83 83 94.9585 83 109.71V270.29C83 285.042 94.9585 297 109.71 297H270.29C285.042 297 297 285.042 297 270.29V109.71ZM342 270.29C342 309.894 309.894 342 270.29 342H109.71C70.1056 342 38 309.894 38 270.29V109.71C38 70.1056 70.1057 38 109.71 38H270.29C309.894 38 342 70.1056 342 109.71V270.29Z" fill="var(--ic-bg)"></path><path d="M253.212 166.242C253.212 165.836 253.023 165.453 252.701 165.205L191.366 117.977C190.895 117.614 190.239 117.614 189.768 117.977L128.433 165.205C128.111 165.453 127.922 165.836 127.922 166.242V253.51C127.922 254.233 128.508 254.82 129.231 254.82H155.046C155.769 254.82 156.355 254.233 156.355 253.51V196.091C156.356 184.322 165.897 174.781 177.666 174.781H202.855C214.624 174.781 224.165 184.322 224.165 196.091V253.51C224.165 254.233 224.752 254.82 225.476 254.82H251.902C252.626 254.82 253.212 254.233 253.212 253.51V166.242ZM273.212 253.51C273.212 265.279 263.671 274.82 251.902 274.82H225.476C213.706 274.82 204.165 265.279 204.165 253.51V196.091C204.165 195.368 203.579 194.781 202.855 194.781H177.666C176.943 194.781 176.356 195.367 176.355 196.091V253.51C176.355 265.279 166.815 274.82 155.046 274.82H129.231C117.462 274.82 107.922 265.279 107.922 253.51V166.242C107.922 159.63 110.992 153.393 116.23 149.358L177.565 102.13C185.229 96.2293 195.905 96.2293 203.568 102.13L264.903 149.358C270.142 153.393 273.212 159.63 273.212 166.242V253.51Z" fill="var(--ic-fg)"></path><path d="M270.29 296.677L270.29 319.5H109.71L109.71 296.677H270.29ZM296.677 270.29V109.71C296.677 95.1373 284.863 83.3242 270.29 83.3242H109.71C95.1373 83.3242 83.3242 95.1373 83.3242 109.71V270.29C83.3242 284.863 95.1373 296.677 109.71 296.677L109.71 319.5C82.7443 319.5 60.8443 297.811 60.5039 270.926L60.5 270.29V109.71C60.5 82.5321 82.5321 60.5 109.71 60.5H270.29C297.468 60.5 319.5 82.5321 319.5 109.71V270.29C319.5 297.256 297.811 319.156 270.926 319.496L270.29 319.5L270.29 296.677C284.863 296.677 296.677 284.863 296.677 270.29Z" fill="var(--ic-fg)"></path></svg><div class="flex flex-col gap-1"><p class="text-body-lg font-semibold text-text-default">Backup that kicks in automatically</p><p class="text-body-md font-medium text-text-muted text-pretty">When the grid goes down, your battery takes over instantly. Most members don&#x27;t even notice.</p></div></li><li class="flex items-start gap-4"><svg viewBox="0 0 380 380" fill="none" width="100%" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="size-12 shrink-0" style="--ic-bg:var(--color-green-20);--ic-fg:var(--color-green-90)"><path d="M319 190C319 261.797 260.797 320 189 320C117.203 320 59 261.797 59 190C59 118.203 117.203 60 189 60C260.797 60 319 118.203 319 190Z" fill="var(--ic-bg)"></path><path d="M296.5 190C296.5 130.629 248.371 82.5 189 82.5C129.629 82.5 81.5 130.629 81.5 190C81.5 249.371 129.629 297.5 189 297.5C248.371 297.5 296.5 249.371 296.5 190ZM341.5 190C341.5 274.223 273.223 342.5 189 342.5C104.777 342.5 36.5 274.223 36.5 190C36.5 105.777 104.777 37.5 189 37.5C273.223 37.5 341.5 105.777 341.5 190Z" fill="var(--ic-bg)"></path><path fill-rule="evenodd" clip-rule="evenodd" d="M229.063 113.571C231.679 113.571 234.154 114.761 235.788 116.804L265.543 153.998C267.611 156.583 268.014 160.126 266.58 163.109C265.146 166.093 262.129 167.99 258.819 167.99H246.982L265.543 191.192C267.611 193.778 268.014 197.32 266.58 200.304C265.146 203.287 262.129 205.184 258.819 205.185H232.654L244.857 253.995C245.5 256.568 244.922 259.294 243.29 261.384C241.658 263.474 239.153 264.696 236.501 264.696H147.235C144.583 264.696 142.079 263.474 140.447 261.384C138.815 259.294 138.237 256.568 138.88 253.995L151.082 205.185H124.918C121.608 205.184 118.59 203.287 117.156 200.304C115.721 197.32 116.125 193.778 118.193 191.192L136.754 167.99H124.918C121.608 167.99 118.59 166.093 117.156 163.109C115.721 160.126 116.125 156.583 118.193 153.998L147.949 116.804C149.583 114.761 152.058 113.571 154.674 113.571H229.063ZM158.266 247.471H225.471L214.9 205.185H168.837L158.266 247.471ZM142.838 187.96H153.5V174.632L142.838 187.96ZM170.725 187.96H213.011V167.99H170.725V187.96ZM230.237 187.96H240.899L230.237 174.632V187.96ZM142.837 150.766H153.5V137.437L142.837 150.766ZM170.725 150.766H213.011V130.796H170.725V150.766ZM230.237 150.766H240.899L230.237 137.438V150.766Z" fill="var(--ic-fg)"></path><path d="M298 190C298 130.906 250.094 83 191 83C131.906 83 84 130.906 84 190C84 249.094 131.906 297 191 297V320C119.203 320 61 261.797 61 190C61 118.203 119.203 60 191 60C262.797 60 321 118.203 321 190C321 261.797 262.797 320 191 320V297C250.094 297 298 249.094 298 190Z" fill="var(--ic-fg)"></path></svg><div class="flex flex-col gap-1"><p class="text-body-lg font-semibold text-text-default">We earn from the grid, not you</p><p class="text-body-md font-medium text-text-muted text-pretty">Your battery helps balance the grid during peak demand, which is how we keep your rates low.</p></div></li></ul></div></div></section></div><div aria-hidden="false" class="absolute inset-0 z-10 flex items-center justify-center px-4 md:px-8 py-16 transition-opacity duration-700 opacity-100"><div class="absolute inset-0 bg-[#f0eeeb]/35"></div><div class="relative w-full max-w-[578px] px-8 py-14 md:px-[52px] flex flex-col items-center gap-[35px] shadow-xl bg-white" style="border-radius:16px"><div class="flex flex-col items-center gap-3 text-center"><div class="w-[68px]"><img src="/_bpc/assets/base-core-concept/pricing-dollar.avif" alt="" class="block w-full"/></div><h2 class="text-balance text-heading-md font-semibold text-[#1e4d2b]">Backup at a price Americans can afford</h2><p class="max-w-[440px] text-balance text-body-md font-medium text-text-muted">Select your utility provider to view plans and pricing available in your area.</p></div><div class="w-full max-w-[473px]"><div class="relative"><div class="relative z-20 flex cursor-text items-center gap-2 rounded-[8px] border border-border-default bg-white px-5 py-4 shadow-sm"><input type="text" role="combobox" aria-expanded="false" aria-haspopup="listbox" aria-autocomplete="list" placeholder="Who is your utility provider?" style="outline:none;box-shadow:none" class="w-full appearance-none border-0 bg-transparent p-0 text-body-lg font-medium text-text-default placeholder:text-text-muted" value=""/><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0 text-text-muted transition-transform "><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div></div></div></div></div><!--astro:end--></astro-island> </section> <section class="bcc-say" data-bcc-scrub="runway" data-bcc-scrub-sm="travel" data-bcc-wide aria-labelledby="bcc-say-head"> <div class="bcc-say-screen" data-bcc-clear> <div class="bcc-say-inner">  <h2 class="bcc-say-head" id="bcc-say-head" data-bcc-reveal> <span class="bcc-say-h1">What members</span> <span class="bcc-say-h2">are saying</span> </h2>    <ul class="bcc-say-deck" role="list" data-bcc-gather="5 -4 center"> <li class="bcc-say-card" data-bcc-gather-item style="--i:0; --ws:0.248; --wd:0.13; --xs:0.680; --xd:0.200; --dx:88.6; --dy:48.0; --r0:5.12; --r1:-1.95; --jx:0; --cw:26.15; --cx:0.31; --cy:0"> <blockquote class="bcc-say-quote"> <span class="bcc-say-stars" role="img" aria-label="Rated 5 out of 5"> <svg viewBox="0 0 118 22" aria-hidden="true" focusable="false"> <path transform="translate(0 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(23 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(46 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(69 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(92 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path> </svg> </span> <p class="bcc-say-text">“I recommend switching to BASE power. It is better and more cost effective than a standby generator. This cost is the same or lower than most providers, and you get eight to twenty hours of standby power, plus the option to add a generator port to charge the battery and extend the time (which I did), so you get the best of both worlds. The installation was awesome, their techs know the NEC and know what they are doing. They handle your HOA and everything. Glad I made the switch.”</p> <footer class="bcc-say-by"> <svg class="bcc-say-g" viewBox="0 0 24 24" aria-hidden="true" focusable="false"> <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path> <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path> <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"></path> <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path> </svg> <cite class="bcc-say-name">David Kalinec</cite> </footer> </blockquote> </li><li class="bcc-say-card" data-bcc-gather-item style="--i:1; --ws:0.215; --wd:0.13; --xs:0.692; --xd:0.188; --dx:83.7; --dy:31.6; --r0:10.70; --r1:-2.85; --jx:33; --cw:26.15; --cx:5.23; --cy:32.42"> <blockquote class="bcc-say-quote"> <span class="bcc-say-stars" role="img" aria-label="Rated 5 out of 5"> <svg viewBox="0 0 118 22" aria-hidden="true" focusable="false"> <path transform="translate(0 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(23 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(46 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(69 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(92 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path> </svg> </span> <p class="bcc-say-text">“I have nothing but great things to say about Base Power. Great bunch of people for starters. The system works super well. We have found out that power has failed because our neighbors asked if anyone else has lost power (we didn’t 😊). I 100% recommend this over any other backup option. We added a plug for our external generator in case there is a longer outage. When you do a cost/benefit analysis, this solution is unbeatable. Give it a try!”</p> <footer class="bcc-say-by"> <svg class="bcc-say-g" viewBox="0 0 24 24" aria-hidden="true" focusable="false"> <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path> <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path> <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"></path> <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path> </svg> <cite class="bcc-say-name">Carlos Contreras</cite> </footer> </blockquote> </li><li class="bcc-say-card bcc-say-photo" data-bcc-gather-item style="--i:2; --ws:0.210; --wd:0.16; --xs:0.684; --xd:0.166; --dx:88.2; --dy:17.8; --r0:6.90; --r1:0.70; --jx:-23; --cw:27.69; --cx:0; --cy:61.82"> <img class="bcc-say-img" src="/_bpc/assets/base-core-concept/say-photo-porch.avif" alt="A Base customer talking with a Base team member beside their Base Core battery" width="1080" height="600" loading="lazy" decoding="async"> </li><li class="bcc-say-card" data-bcc-gather-item style="--i:3; --ws:0.204; --wd:0.13; --xs:0.728; --xd:0.152; --dx:54.0; --dy:47.0; --r0:6.92; --r1:1.00; --jx:9; --cw:26.15; --cx:34.92; --cy:1.97"> <blockquote class="bcc-say-quote"> <span class="bcc-say-stars" role="img" aria-label="Rated 5 out of 5"> <svg viewBox="0 0 118 22" aria-hidden="true" focusable="false"> <path transform="translate(0 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(23 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(46 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(69 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(92 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path> </svg> </span> <p class="bcc-say-text">“Everyone needs these battery systems! Help yourself and your neighbors at the same time. This is the future for power outages and costly expansion of power grids. Check it out and get approved asap. You will not regret doing this and you will sleep better knowing that you’ll have reliable power during your next outage. I ended up with two batteries, 50kWh of power. 100% confidence that my cpap machine will work all night!”</p> <footer class="bcc-say-by"> <svg class="bcc-say-g" viewBox="0 0 24 24" aria-hidden="true" focusable="false"> <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path> <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path> <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"></path> <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path> </svg> <cite class="bcc-say-name">Gordon RN</cite> </footer> </blockquote> </li><li class="bcc-say-card bcc-say-photo" data-bcc-gather-item style="--i:4; --ws:0.180; --wd:0.16; --xs:0.726; --xd:0.124; --dx:51.9; --dy:32.7; --r0:10.68; --r1:-0.34; --jx:0; --cw:27.69; --cx:36.23; --cy:32.42"> <img class="bcc-say-img" src="/_bpc/assets/base-core-concept/say-photo-install.avif" alt="Two Base electricians wiring a home's meter panel during an install" width="1080" height="600" loading="lazy" decoding="async"> </li><li class="bcc-say-card" data-bcc-gather-item style="--i:5; --ws:0.136; --wd:0.13; --xs:0.715; --xd:0.165; --dx:54.2; --dy:18.1; --r0:5.12; --r1:-1.31; --jx:-1; --cw:26.15; --cx:34.69; --cy:58.94"> <blockquote class="bcc-say-quote"> <span class="bcc-say-stars" role="img" aria-label="Rated 5 out of 5"> <svg viewBox="0 0 118 22" aria-hidden="true" focusable="false"> <path transform="translate(0 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(23 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(46 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(69 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(92 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path> </svg> </span> <p class="bcc-say-text">“Totally satisfied with BASE. Great rate for energy, and the battery kicks in seamlessly when the grid goes down. No issues for me. And no generator noise!!”</p> <footer class="bcc-say-by"> <svg class="bcc-say-g" viewBox="0 0 24 24" aria-hidden="true" focusable="false"> <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path> <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path> <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"></path> <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path> </svg> <cite class="bcc-say-name">Jonathan Sullivan</cite> </footer> </blockquote> </li><li class="bcc-say-card bcc-say-photo" data-bcc-gather-item style="--i:6; --ws:0.161; --wd:0.16; --xs:0.691; --xd:0.159; --dx:23.2; --dy:43.5; --r0:9.57; --r1:-1.67; --jx:29; --cw:27.69; --cx:65; --cy:11.21"> <img class="bcc-say-img" src="/_bpc/assets/base-core-concept/say-photo-service.avif" alt="A Base technician servicing the top panel of a Base Core battery" width="1080" height="600" loading="lazy" decoding="async"> </li><li class="bcc-say-card" data-bcc-gather-item style="--i:7; --ws:0.110; --wd:0.13; --xs:0.686; --xd:0.194; --dx:15.3; --dy:30.4; --r0:8.57; --r1:-0.96; --jx:-11; --cw:26.15; --cx:73.62; --cy:34.7"> <blockquote class="bcc-say-quote"> <span class="bcc-say-stars" role="img" aria-label="Rated 5 out of 5"> <svg viewBox="0 0 118 22" aria-hidden="true" focusable="false"> <path transform="translate(0 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(23 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(46 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(69 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(92 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path> </svg> </span> <p class="bcc-say-text">“I&#39;m an early adopter of BASE and love it. I enjoy the peace of mind of knowing a power outage is less of a worry, and the competitive pricing for electricity is the icing on the cake. I couldn&#39;t be happier!”</p> <footer class="bcc-say-by"> <svg class="bcc-say-g" viewBox="0 0 24 24" aria-hidden="true" focusable="false"> <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path> <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path> <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"></path> <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path> </svg> <cite class="bcc-say-name">Jeff Semler</cite> </footer> </blockquote> </li><li class="bcc-say-card" data-bcc-gather-item style="--i:8; --ws:0.094; --wd:0.13; --xs:0.691; --xd:0.189; --dx:22.2; --dy:17.8; --r0:5.59; --r1:-2.36; --jx:0; --cw:26.15; --cx:66.77; --cy:59.55"> <blockquote class="bcc-say-quote"> <span class="bcc-say-stars" role="img" aria-label="Rated 5 out of 5"> <svg viewBox="0 0 118 22" aria-hidden="true" focusable="false"> <path transform="translate(0 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(23 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(46 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(69 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path><path transform="translate(92 0) scale(0.875)" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path> </svg> </span> <p class="bcc-say-text">“I just passed my one year anniversary and I love BASE. When I first started with BASE I knew that this would be one of my greatest decisions ever as a homeowner or a terrible decision. I am on cloud nine and couldn’t be happier with the entire BASE experience. I have 100% Peace of Mind as a homeowner. I live in Houston Texas and I have experienced every hurricane here since 1980. I highly recommend BASE to everyone.”</p> <footer class="bcc-say-by"> <svg class="bcc-say-g" viewBox="0 0 24 24" aria-hidden="true" focusable="false"> <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path> <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path> <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z" fill="#FBBC05"></path> <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path> </svg> <cite class="bcc-say-name">Angelo V</cite> </footer> </blockquote> </li> </ul>  <div class="bcc-say-runway" aria-hidden="true"></div> </div> </div> </section> <section class="bcc-specs" aria-labelledby="bcc-specs-head" data-bcc-core-rain> <div class="bcc-specs-inner"> <h2 class="bcc-specs-head" id="bcc-specs-head" data-bcc-reveal>
Base Core specs<svg width="100%" height="10" viewBox="44 149 212 19" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none" class="block bcc-specs-stroke"><path d="M46.189 161.553C58.3867 161.345 70.6266 161.191 82.6133 158.867C120.776 155.148 158.334 150.869 196.547 150.155C215.572 149.797 234.873 150.048 253.67 151.024C257.336 154.132 250.725 155.061 248.351 155.261C228.982 156.892 206.756 155.168 186.983 155.781C141.587 157.188 96.8898 165.033 52.0009 166.516C49.9952 166.583 47.905 166.597 46.0849 165.638C44.7768 164.175 45.1425 162.963 46.1918 161.553L46.189 161.553Z" fill="#ed6c30"></path></svg> </h2> <div class="bcc-specs-group" data-bcc-reveal style="--rd:0.06s"> <h3 class="bcc-specs-gtitle" data-bcc-reveal style="--rd:0.06s"> Power </h3> <dl class="bcc-specs-rows"> <div class="bcc-specs-cell" data-bcc-reveal style="--rd:0.090s"> <dt class="text-label-xs">Energy Capacity</dt> <dd class="text-body-md"> <button class="bcc-core-rain-trigger" type="button" data-bcc-core-rain-trigger aria-label="39.2 kWh total energy. Activate Core shower."> 39.2 kWh total energy </button> </dd> </div><div class="bcc-specs-cell" data-bcc-reveal style="--rd:0.108s"> <dt class="text-label-xs">Reduced usage duration</dt> <dd class="text-body-md"> Up to 36 hours </dd> </div><div class="bcc-specs-cell" data-bcc-reveal style="--rd:0.126s"> <dt class="text-label-xs">AC Voltage (nominal)</dt> <dd class="text-body-md"> 120/240 V </dd> </div><div class="bcc-specs-cell" data-bcc-reveal style="--rd:0.144s"> <dt class="text-label-xs">Grid frequency</dt> <dd class="text-body-md"> 60 Hz </dd> </div> </dl> </div><div class="bcc-specs-group" data-bcc-reveal style="--rd:0.16s"> <h3 class="bcc-specs-gtitle" data-bcc-reveal style="--rd:0.16s"> Features </h3> <dl class="bcc-specs-rows"> <div class="bcc-specs-cell" data-bcc-reveal style="--rd:0.190s"> <dt class="text-label-xs">Size</dt> <dd class="text-body-md"> 35.9&quot; H x 30.68&quot; W x 22&quot; </dd> </div><div class="bcc-specs-cell" data-bcc-reveal style="--rd:0.208s"> <dt class="text-label-xs">Operating temperature</dt> <dd class="text-body-md"> -22 to 122 °F </dd> </div><div class="bcc-specs-cell" data-bcc-reveal style="--rd:0.226s"> <dt class="text-label-xs">Noise</dt> <dd class="text-body-md"> 55 dBA (at 1 meter) </dd> </div><div class="bcc-specs-cell" data-bcc-reveal style="--rd:0.244s"> <dt class="text-label-xs">Auto-switch</dt> <dd class="text-body-md"> Seamless (50 milliseconds) </dd> </div> </dl> </div><div class="bcc-specs-group" data-bcc-reveal style="--rd:0.26s"> <h3 class="bcc-specs-gtitle" data-bcc-reveal style="--rd:0.26s"> Other details </h3> <dl class="bcc-specs-rows"> <div class="bcc-specs-cell" data-bcc-reveal style="--rd:0.290s"> <dt class="text-label-xs">Lifetime</dt> <dd class="text-body-md"> 12 years </dd> </div><div class="bcc-specs-cell" data-bcc-reveal style="--rd:0.308s"> <dt class="text-label-xs">Core maintenance</dt> <dd class="text-body-md"> Base handles all service and maintenance for the lifetime of the battery. </dd> </div><div class="bcc-specs-cell bcc-specs-cell-wide" data-bcc-reveal style="--rd:0.326s"> <dt class="text-label-xs">Certifications</dt> <dd class="text-body-md"> UL 1973, UL 9540, UL 991, UL 1998, UL 1741, IEEE 1547-2003 </dd> </div> </dl> </div> </div> <div class="bcc-core-rain-overlay" data-bcc-core-rain-overlay aria-hidden="true"></div> <span class="bcc-core-rain-status" data-bcc-core-rain-status role="status" aria-live="polite"></span> </section> <script type="module">globalThis.process??={};globalThis.process.env??={};const h="/_bpc/assets/base-core-concept",l=[`${h}/core-back-profile.avif`,`${h}/core-front-hero.avif`,`${h}/core-front.avif`,`${h}/core-right.avif`,`${h}/core-hero-profile.avif`,`${h}/core-back.avif`],d=(r,t,a)=>r+(t-r)*a();function x(r,t=Math.random){const a=r<478,c=!a&&r<768,g=a?10:c?14:20,o=a?44:c?52:60,m=a?92:c?112:140,u=Math.floor(t()*l.length);return Array.from({length:g},(v,f)=>{const s=d(o,m,t),